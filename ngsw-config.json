{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/**/games/**"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "cacheQueryOptions": {
        "ignoreSearch": true
      },
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "cacheQueryOptions": {
        "ignoreSearch": true
      },
      "resources": {
        "files": [
          "/assets/**",
          "/games/**"
        ]
      }
    }
  ]
}
